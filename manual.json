          "dialog": "Tabular data"
        },
        {
          "click": "#table-keys-choose",
          "label": "Choose key columns…",
          "dialog": "Tabular data",
          "opens": "Key columns"
        },
        {
          "fill": "table-keys-paste",
          "label": "Columns to keep, pasted or typed",
          "value": "date, o3_lag02_10, pm25_lag02_10, no2_lag02_10, tmean_lag03, holiday, stratum",
          "dialog": "Key columns"
        },
        {
          "click": "#table-keys-keep",
          "label": "Keep these",
          "dialog": "Key columns"
        },
        {
          "click": "#table-keys-done",
