    {
      "name": "How much does ozone raise visits?",
      "question": "The authors' model: daily visits on ozone over the previous three days, adjusted for PM2.5, NO2, temperature and holidays, within year-month-weekday strata. Their result: 1.061 (1.035-1.088) per 10 ppb.",
      "steps": [
        {
          "click": "#add-workflow",
          "label": "Add workflow"
        },
        {
          "fill": "workflow-name-edit",
